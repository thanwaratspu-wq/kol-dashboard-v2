# ===== Data driver: 'json' (ชั่วคราว) หรือ 'postgres' (เมื่อพร้อม) =====
DATA_DRIVER=json

# ===== PostgreSQL (ใช้เมื่อ DATA_DRIVER=postgres) =====
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kol_v2

# ===== JWT / Security =====
# เปลี่ยนเป็นสตริงสุ่มยาว ๆ ก่อนใช้จริง
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== บัญชีเริ่มต้น (ใช้ตอน seed) =====
# ต้องตั้งรหัสเองทั้งสองตัว ไม่งั้น seed จะไม่ยอมรัน
# ห้ามใช้ค่าตัวอย่างด้านล่างจริง ๆ — เปลี่ยนเป็นรหัสของตัวเองก่อน
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULLNAME=System Admin
MEMBER_PASSWORD=

# ===== Server =====
PORT=4000
NODE_ENV=development
